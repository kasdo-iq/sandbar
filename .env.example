# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Server-side vars are read at startup (see start_server.py / app/auth.py).
# LLM keys are referenced BY NAME in providers.yaml via `api_key_env`.

# --- Server ---
# Token for authenticating every HTTP/WS endpoint (Phase 3).
# Accepted via `x-sandbox-token` header or `Authorization: Bearer <t>`.
SANDBOX_API_TOKEN=change-me-to-a-long-random-string
# Set to true ONLY for local dev without auth (server refuses to start
# without a token otherwise). Loud warning is logged when used.
AUTH_DISABLED=false
# Comma-separated CORS allowlist. Empty = no browser cross-origin access.
CORS_ORIGINS=

# --- Manus compatibility ---
# When true (default), data_api.py's Manus ApiClient is wired/usable.
MANUS_COMPAT=true
# Base host for the Manus API proxy used by data_api.py.
RUNTIME_API_HOST=https://api.manus.im
# Host used to reach this sandbox's own API when calling it locally.
#RUNTIME_API_HOST=http://localhost

# --- Browser ---
# Path to Chromium/Chrome inside the sandbox (set by Dockerfile already).
#CHROME_INSTANCE_PATH=/usr/bin/chromium

# --- LLM provider API keys (names referenced from providers.yaml) ---
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Search backends (web_search tool picks whichever is configured)
TAVILY_API_KEY=
BRAVE_API_KEY=
SEARXNG_URL=

# --- Telemetry (browser_use vendored lib) ---
# posthog: "false" disables it. Laminar (lmnr) only activates with an API key.
ANONYMIZED_TELEMETRY=false
#LAMINAR_API_KEY=

# --- Logging ---
BROWSER_USE_LOGGING_LEVEL=info
